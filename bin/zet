#!/bin/bash

# Setup ID and Timestamp
# Zettelkasten ID: YYYYMMDDHHMM
ZID=$(date "+%Y%m%d%H%M")
TIMESTAMP=$(date "+%Y-%m-%d %H:%M")

# Pathing (using $SECOND_BRAIN variable)
# Defaulting to ~/Notes if $SECOND_BRAIN isn't set in environment
ZET_DIR="${SECOND_BRAIN:-$HOME/Notes}/00-zettelkasten/zet"
mkdir -p "$ZET_DIR"

# Handle Title and Filename
# If no title is provided, use "New Zettel"
TITLE="${1:-New Zettel}"
# Slugify the title for the filename (e.g., "My Note" -> "my-note")
SLUG=$(echo "$TITLE" | tr '[:upper:]' '[:lower:]' | tr -s ' ' '_' | tr -dc 'a-z0-0-')
FILEPATH="$ZET_DIR/${ZID}-${SLUG}.md"

# --- Lino to Daily Note with Status Check --
DAILY_DATE=$(date "+%Y-%m-%d")
# Matching specific path: periodic-notes/daily-notes/
DAILY_NOTE="${SECOND_BRAIN:-$HOME/Notes}/periodic-notes/daily-notes/${DAILY_DATE}.md"

if [ -f "$DAILY_NOTE" ]; then
  # Add a header if it's the first Zettel of the day
  if ! grep -q "## Created Zettels" "$DAILY_NOTE"; then
    echo -e "\n## Created Zettels" >>"$DAILY_NOTE"
  fi

  # Append as a Task: - [ ] [[Filename|Title]]
  # This lets us 'check it off' once the Zettel is fully processed/linked
  echo "- [ ] [[${ZID}-${SLUG}|${TITLE}]]" >>"$DAILY_NOTE"
  echo "Added link to Daily Note: $DAILY_DATE"
else
  echo "⚠️  Daily note for today not found. Skipping link."
fi

# Create Template if it doesn't exist
if [ ! -f "$FILEPATH" ]; then
  cat <<EOF >"$FILEPATH"
---
id: $ZID
title: "$TITLE"
date: $TIMESTAMP
tags: [unprocessed]
---

# $TITLE


- Source:

## Notes
- 

## References
- 
EOF
  echo "Created Zettel: $FILEPATH"
fi

# Open in Neovim
nvim "$FILEPATH"
