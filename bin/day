#!/bin/bash

if command -v gdate > /dev/null 2>&1; then
   DATE_BIN="gdate"
else
   DATE_BIN="date"
fi


today=$(date +"%Y-%m-%d")
tomorrow=$($DATE_BIN -d "tomorrow" '+%Y-%m-%d')
yesterday=$(DATE_BIN -d "yesterday" '+%Y-%m-%d')
TITLE=$(echo "${today}-daily-note")
TITLE_YESTERDAY=$(echo "${yesterday}-daily-note")
TITLE_TOMORROW=$(echo "${tomorrow}-daily-note")

# file="$SECOND_BRAIN"'/periodic-notes/daily-notes/'$(date +"%Y-%m-%d").md

file="${SECOND_BRAIN}/periodic-notes/daily-notes/${TITLE}.md"
# The Zettelkasten ID (YYYYMMDDHHMM)
# This serves as your "Permanent Address" for the note
ZID=$(date "+%Y%m%d%H%M")
TIMESTAMP=$(date "+%Y-%m-%d %H:%M")

cd "$SECOND_BRAIN" || exit

new_note() {
   touch "$file"

   # Format the file with the daily template
   cat <<EOF >$file
---
id: $ZID
title: "$TITLE"
date: $TIMESTAMP
tags: [daily-note]
---
$file

# $today

[[$TITLE_YESTERDAY]] - [[$TITLE_TOMORROW]]

## Intention

What do I want to achieve today and tomorrow?

## Tracking

- [ ] Calories tracked
- [ ] Run
- [ ] Yoga or strength training
- [ ] Meditation
- [ ] Answer 1 question from steps
- [ ] Skin routine
- [ ] Oral routine

## Links

- $ZID

## Log
EOF

}


# If the daily note does not exist, create a new one.
# this uses the test command with the -f flag.
if [ ! -f "$file" ]; then
   echo "File does not exist, creating new daily note."
   new_note
fi

# Open the daily note at the bottom of the file in insert mode and run NoNeckPain to make it center
nvim '+ normal Gzzo' "$file" -c :NoNeckPain
